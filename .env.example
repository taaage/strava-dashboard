# Required — URL of your strava-api backend (no trailing slash)
VITE_API_BASE=https://your-api.vercel.app

# Mapbox public token (pk...) for ride route maps — https://account.mapbox.com/access-tokens
# Restrict by URL (your domain + localhost) in the Mapbox dashboard.
VITE_MAPBOX_TOKEN=

# Distance goals (km) — shown as radial progress rings
VITE_WEEKLY_GOAL_KM=150
VITE_MONTHLY_GOAL_KM=650
VITE_YEARLY_GOAL_KM=10000

# Power reference profile for the radar chart — JSON object with 14 keys.
# Default is ~Cat B racing (3.6 W/kg @ 85 kg). Adjust to your level.
VITE_POWER_REFERENCE='{"5s":1200,"15s":950,"30s":720,"1min":570,"2min":470,"3min":430,"5min":390,"8min":365,"10min":355,"15min":340,"20min":330,"30min":315,"45min":300,"60min":290}'
VITE_POWER_REFERENCE_LABEL=Cat B reference

# Ride category thresholds (average watts) for the HR vs Power chart
VITE_CATEGORY_RACE_MIN_WATTS=250
VITE_CATEGORY_TEMPO_MIN_WATTS=200
VITE_CATEGORY_ENDURANCE_MIN_WATTS=150